# python manage.py init ilk kurulumda rastgele SECRET_KEY içeren .env üretir.
# Bu örneği kopyalarsanız SECRET_KEY alanını en az 32 karakterlik rastgele değerle doldurun.
SECRET_KEY=

# Boş bırakılırsa proje içindeki instance/ kullanılır. Alternatif: mutlak dizin yolu.
BRIVA_DATA_DIR=

# Opsiyonel eski AI modülü. Yerel denemede boş bırakın; gereksinim: requirements-ai.txt.
# İşlem yetkileri doğrulanmadan gerçek stok ve cari verilerle etkinleştirmeyin.
GROQ_API_KEY=
