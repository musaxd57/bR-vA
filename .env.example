# Placeholder only. Never commit a real .env or secret.
# manage.py init creates a random SECRET_KEY for a new empty installation.
SECRET_KEY=
# Empty uses instance/. Keep production databases separate from test fixtures.
BRIVA_DATA_DIR=
BRIVA_TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
# Local HTTP only. Production HTTPS requires a reviewed deployment setup.
BRIVA_HTTPS=0
# Keep zero; archived stock and money routes are read-only.
BRIVA_ALLOW_LEGACY_WRITES=0
# manage.py configure-local-auth generates a local key without enabling MFA.
BRIVA_AUTH_ENCRYPTION_KEY=
# AI is not part of the authoritative stock calculation. Legacy AI is retired.
GROQ_API_KEY=
OPENAI_API_KEY=
